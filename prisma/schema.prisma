// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum Role {
  customer
  admin
  editor
}

/// Salutation shown on invoices and in order correspondence. `ms` is included
/// alongside mr/mrs so customers aren't forced to disclose marital status.
enum Title {
  mr
  mrs
  ms
}

enum PaymentMethod {
  razorpay
  cod
}

enum PaymentStatus {
  pending
  paying // transient "claimed" state — see fulfillOrder()
  paid
  failed
  refunded
}

enum OrderStatus {
  placed
  confirmed
  processing
  shipped
  delivered
  cancelled
  return_requested
  returned
  refunded
}

enum RefundStatus {
  idle
  processing
  completed
  failed
}

enum ContentStatus {
  draft
  published
  archived
}

// ─── Auth ─────────────────────────────────────────────────────────────────

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String    @unique
  emailVerified          DateTime?
  passwordHash           String? // null for OAuth-only or guest accounts
  image                  String?
  role                   Role      @default(customer)
  title                  Title?
  phone                  String?
  /// Date only — no time component, and never used for anything but birthday
  /// offers, so it stays nullable and optional at signup.
  dateOfBirth            DateTime? @db.Date
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  cart      Cart?
  wishlist  Wishlist?
  reviews   Review[]
  /// Expenses this account entered. See the Books section at the foot of
  /// this file — the relation is SetNull, so removing a staff account leaves
  /// the ledger intact and simply forgets who typed it in.
  expenses  Expense[]

  accounts Account[]
  sessions Session[]

  createdContentEntries   ContentEntry[] @relation("ContentEntryCreatedBy")
  updatedContentEntries   ContentEntry[] @relation("ContentEntryUpdatedBy")
  publishedContentEntries ContentEntry[] @relation("ContentEntryPublishedBy")
  uploadedMedia           MediaAsset[]

  @@index([role])
}

model Address {
  id           String  @id @default(cuid())
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  label        String?
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  isDefault    Boolean @default(false)
  // Single-default-per-user invariant is enforced via a partial unique index,
  // added in a raw-SQL migration (Prisma can't express partial unique indexes
  // declaratively): CREATE UNIQUE INDEX one_default_address_per_user
  // ON "Address"("userId") WHERE "isDefault" = true;

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Catalog ──────────────────────────────────────────────────────────────

/// Per-size stock. One row per (product, size).
///
/// A real table rather than a JSON map on Product because the ordering
/// invariant is the conditional UPDATE in src/server/products/stock.ts —
/// `where: { stock: { gte: quantity } }` — which only works against a column.
/// A JSON blob would have to be read, modified and written back, and two
/// concurrent orders for the last unit would both succeed.
model ProductVariant {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  /// Matches one entry of Product.sizes exactly.
  size      String
  stock     Int     @default(0)

  @@unique([productId, size])
  @@index([productId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  /// Lucide icon name shown beside the label in the header nav — resolved by
  /// src/components/storefront/cms/cms-icon.tsx, which falls back to rendering
  /// the value as text so an emoji works too. Null = label only.
  icon        String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String?
  shortDescription String?
  price            Decimal  @db.Decimal(10, 2)
  compareAtPrice   Decimal? @db.Decimal(10, 2)
  /// What this piece cost US — the purchase price from the supplier.
  ///
  /// Nullable because the catalogue predates it: a product with no cost is
  /// simply excluded from margin figures rather than counted as free, and the
  /// finance screens say how many are missing. Never show this to a shopper.
  costPrice        Decimal? @db.Decimal(10, 2)
  images           String[] // Cloudinary URLs only — validated in server layer
  videoUrl         String?
  category         Category @relation(fields: [categoryId], references: [id])
  categoryId       String
  weight           Decimal? @db.Decimal(10, 3)
  purity           String   @default("925 Sterling Silver")
  dimensions       String?
  /// The sizes offered, in display order. The authoritative per-size stock
  /// lives on ProductVariant — this array is the ordering and the label set.
  sizes            String[]
  material         String?
  /// Total across every size, maintained in the same transaction that writes
  /// ProductVariant.stock. Denormalised on purpose: every listing, the search
  /// query, homepage sections and the scarcity labels filter on it, and making
  /// them all aggregate variants would be a far larger and riskier change.
  /// Never write this directly for a sized product — use src/server/products/stock.ts.
  stock            Int      @default(0)
  sku              String   @unique
  isFeatured       Boolean  @default(false)
  isBestseller     Boolean  @default(false)
  isActive         Boolean  @default(true) // soft delete
  tags             String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderItems   OrderItem[]
  reviews      Review[]
  cartItems    CartItem[]
  variants     ProductVariant[]
  wishlistedIn Wishlist[]       @relation("WishlistProducts")

  // Full-text search column — a GENERATED ALWAYS ... STORED tsvector plus a GIN
  // index, created by raw SQL in the init migration because Prisma can't
  // express generated columns.
  //
  // ⚠️  DO NOT RUN `prisma migrate dev` ON THIS PROJECT.
  // Prisma cannot model this column either way: left undeclared it plans to
  // DROP "searchVector" (destroying product search); declared as
  // Unsupported("tsvector") it tries to ALTER the column default, which
  // Postgres rejects with 42601 on a generated column.
  //
  // Write migrations by hand in prisma/migrations/<timestamp>_<name>/migration.sql
  // and apply them with `prisma migrate deploy`. See docs/migrations.md.
  // searchVector Unsupported("tsvector")?

  @@index([categoryId, isActive])
  @@index([price])
  @@index([createdAt(sort: Desc)])
  @@index([isActive, isFeatured])
  @@index([isActive, isBestseller])
}

// ─── Cart / Wishlist / Reviews ─────────────────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String  @id @default(cuid())
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int
  /// The size the shopper chose, exactly as listed in Product.sizes ("8",
  /// "18 in", "M"). Empty string, never null, for products with no sizes —
  /// Postgres treats NULLs as distinct in a unique index, so a nullable column
  /// here would let the same unsized product be added as unlimited separate
  /// lines.
  size      String  @default("")

  /// Cart activity, and the only clock this feature has.
  ///
  /// ⚠️  On the ITEM, not the Cart. Prisma's `@updatedAt` fires when the row
  /// it sits on is written, and adding a line never touches the Cart row — so
  /// a timestamp up there would say a cart was last active the day it was
  /// created and never move again. "Last activity" is max(updatedAt) across a
  /// cart's items; see server/admin/carts.ts.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Keyed by size as well as product, so ring size 7 and size 9 are two lines
  /// rather than one overwriting the other.
  @@unique([cartId, productId, size])
}

model Wishlist {
  id       String    @id @default(cuid())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String    @unique
  products Product[] @relation("WishlistProducts")
}

model Review {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId          String
  rating             Int
  title              String?
  comment            String?
  isVerifiedPurchase Boolean  @default(false) // computed server-side only — never client-supplied
  /// Whether shoppers can see it.
  ///
  /// Defaults to TRUE: reviews go live as they are written, and moderation is
  /// after the fact. That is a deliberate choice over holding every review for
  /// approval — a queue nobody empties is how a shop ends up with three
  /// reviews. Flip the default here if that ever stops being true.
  ///
  /// ⚠️  Every storefront read must filter on this. It is enforced in
  /// server/products/reviews.ts and server/reviews/top-reviews.ts, including
  /// the rating AGGREGATE — a hidden review that still moves the star average
  /// is only half hidden.
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId, createdAt(sort: Desc)])
  @@index([isPublished, createdAt(sort: Desc)])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  active       Boolean  @default(true)

  @@index([active])
}

// ─── Orders ─────────────────────────────────────────────────────────────────

model Order {
  id                   String        @id @default(cuid())
  orderNumber          String        @unique // e.g. MYS-000001, from a Postgres sequence
  user                 User          @relation(fields: [userId], references: [id])
  userId               String
  confirmationToken    String?       @unique // guest order access token
  idempotencyKey       String?
  items                OrderItem[]
  shippingAddress      Json // point-in-time snapshot, NOT a live FK
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus @default(pending)
  orderStatus          OrderStatus   @default(placed)
  refundStatus         RefundStatus  @default(idle)
  razorpayOrderId      String?
  razorpayPaymentId    String?       @unique
  subtotal             Decimal       @db.Decimal(10, 2)
  shippingCharge       Decimal       @db.Decimal(10, 2)
  totalAmount          Decimal       @db.Decimal(10, 2)
  notes                String?
  returnReason         String?
  returnRequestedAt    DateTime?
  returnResolvedAt     DateTime?
  refundAmount         Decimal?      @db.Decimal(10, 2)
  refundProcessedAt    DateTime?
  shiprocketOrderId    String?
  shiprocketShipmentId String?
  trackingNumber       String?
  trackingUrl          String?
  courierName          String?
  shipmentCreatedAt    DateTime?
  /// The courier's scan trail, newest first, as stored by the Shiprocket
  /// webhook. Read whole with the order and filtered by nothing, so JSON rather
  /// than a child table — see the migration note.
  shipmentScans        Json?
  /// Issued lazily on first render, not at order creation — see invoice.ts.
  invoiceNumber        String?       @unique
  invoicedAt           DateTime?
  /// Snapshot, so a future rate change cannot reprint old invoices differently.
  gstRatePercent       Decimal?      @db.Decimal(5, 2)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([razorpayOrderId])
  @@index([paymentStatus, createdAt]) // for the 24h stale-pending cron sweep
  @@index([userId, createdAt(sort: Desc)])
  @@index([orderStatus, createdAt(sort: Desc)])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  name      String // snapshot
  image     String? // snapshot
  price     Decimal  @db.Decimal(10, 2) // snapshot
  /// Snapshot of Product.costPrice at the moment of sale.
  ///
  /// ⚠️  Load-bearing for the finance reports. Reading cost off the live
  /// Product instead would mean re-pricing your stock next year silently
  /// rewrites last year's profit. Same reasoning as `price` above.
  costPrice Decimal? @db.Decimal(10, 2) // snapshot
  quantity  Int
  weight    Decimal? @db.Decimal(10, 3) // snapshot
  /// Snapshot of the chosen size. Empty for unsized pieces. This is what
  /// fulfilment picks from, so it must never be derived from the live product —
  /// Product.sizes can change after the order is placed.
  size      String   @default("")
}

// ─── CMS ────────────────────────────────────────────────────────────────────

model ContentType {
  id          String         @id @default(cuid())
  name        String         @unique // 'homepage', 'page', 'blog', 'collection', 'announcement', 'banner'
  label       String
  icon        String?
  description String?
  isSingleton Boolean        @default(false)
  isSystem    Boolean        @default(false) // seeded types; can't be deleted
  fields      Json // array of FieldDefinition — see src/server/cms/content-types.ts
  entries     ContentEntry[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ContentEntry {
  id                 String                @id @default(cuid())
  contentType        ContentType           @relation(fields: [contentTypeId], references: [id])
  contentTypeId      String
  slug               String
  status             ContentStatus         @default(draft)
  data               Json // working draft copy
  publishedData      Json? // decoupled snapshot at last publish
  seoMetaTitle       String?
  seoMetaDescription String?
  seoOgImage         String?
  seoCanonicalUrl    String?
  seoNoIndex         Boolean               @default(false)
  publishedAt        DateTime?
  publishedBy        User?                 @relation("ContentEntryPublishedBy", fields: [publishedById], references: [id])
  publishedById      String?
  createdBy          User?                 @relation("ContentEntryCreatedBy", fields: [createdById], references: [id])
  createdById        String?
  updatedBy          User?                 @relation("ContentEntryUpdatedBy", fields: [updatedById], references: [id])
  updatedById        String?
  versions           ContentEntryVersion[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([contentTypeId, slug])
  @@index([contentTypeId, status])
  @@index([contentTypeId, status, updatedAt(sort: Desc)])
}

model ContentEntryVersion {
  id            String        @id @default(cuid())
  entry         ContentEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId       String
  versionNumber Int
  data          Json
  status        ContentStatus
  label         String?
  savedById     String?
  savedAt       DateTime      @default(now())

  @@index([entryId, versionNumber])
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String // Cloudinary public_id
  originalName String
  url          String
  folder       String   @default("cms")
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  format       String?
  alt          String?
  tags         String[]
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([folder])
}

// ─── Books ──────────────────────────────────────────────────────────────────
//
// The partners' view of the business: what went out, what came in, who put the
// money in, and who is owed what share of the result.
//
// ⚠️  This is a LEDGER, not accounting software. It answers "what did we make
// this month and what is my share of it" for a handful of people who know each
// other. It is not double-entry, it does not do tax, and it must never be
// described to anyone as though it does.
//
// Admin role only, everywhere. See the guard in src/server/admin/finance.ts.

enum ExpenseCategory {
  stock // buying inventory outside the per-product cost price
  packaging
  shipping
  marketing
  salaries
  platform // hosting, Cloudinary, Razorpay fees, domains
  other
}

/// Money spent that is NOT the cost of a specific product.
///
/// Per-piece purchase cost lives on Product.costPrice and reaches the reports
/// through OrderItem — recording it here as well would count it twice. The
/// `stock` category is for inventory bought in bulk that was never attributed
/// to individual pieces.
model Expense {
  id           String          @id @default(cuid())
  /// When the money was actually spent, which is not always when it was
  /// entered. Every report groups on this, never on createdAt.
  spentAt      DateTime
  amount       Decimal         @db.Decimal(10, 2)
  category     ExpenseCategory @default(other)
  note         String?
  /// Who entered it. SetNull rather than Cascade — deleting a staff account
  /// must never delete the books.
  recordedBy   User?           @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([spentAt])
  @@index([category, spentAt])
}

/// A partner in the business.
///
/// Deliberately NOT a User. An investor may never log in, and a member of staff
/// with an admin account is not automatically an investor. Linking the two
/// would mean deleting a login deletes someone's stake.
model Investor {
  id          String       @id @default(cuid())
  name        String
  email       String?
  phone       String?
  /// Share of profit, as a percentage, set by hand.
  ///
  /// ⚠️  Deliberately NOT derived from contributions. Stakes here reflect
  /// effort as well as cash, so the two drift apart on purpose — the finance
  /// screen shows both side by side and flags when the shares do not total 100.
  /// Do not "fix" this by computing it; that decision was made explicitly.
  profitShare Decimal      @default(0) @db.Decimal(5, 2)
  /// Left the business. Kept rather than deleted so historical reports still
  /// balance — a period they were part of must not silently re-split.
  isActive    Boolean      @default(true)
  note        String?
  investments Investment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([isActive])
}

/// One capital contribution. The ledger of who put in what, and when.
model Investment {
  id         String   @id @default(cuid())
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  investorId String
  amount     Decimal  @db.Decimal(10, 2)
  /// When the money arrived. Reports group on this, never on createdAt.
  investedAt DateTime
  note       String?
  createdAt  DateTime @default(now())

  @@index([investorId, investedAt])
  @@index([investedAt])
}

// ─── Store settings ───────────────────────────────────────────────────────

/// Operational switches the shop owner can flip without a deploy: whether COD
/// is offered, whether guests may check out, what shipping costs.
///
/// Deliberately NOT the CMS. ContentEntry carries draft/publish/versioning
/// semantics, and a payment method that only actually turns off once someone
/// remembers to press "Publish" is the wrong shape for a switch. These take
/// effect on write.
///
/// Key/value rather than a one-row table with a column per setting, so adding
/// the next switch is an INSERT and not a migration. The shape of `value` for
/// each key — and the default used when the row is absent — lives in
/// src/server/settings/store-settings.ts, which is the only thing that should
/// read this table.
///
/// ⚠️  A missing row means "use the default", never "off by accident". A fresh
/// production database therefore starts with COD disabled and guest checkout
/// enabled without needing to be seeded.
model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

# Copy this file to .env and fill in real values.
# Never commit .env to git.

# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Use the "Transaction" pooler URL (port 6543) for DATABASE_URL (serverless-safe),
# and the direct connection (port 5432) for DIRECT_URL (used by `prisma migrate`).
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
AUTH_SECRET="change-me-generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret-from-razorpay-dashboard"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"

# ─── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="MY Silvers <orders@mysilvers.in>"

# ─── Upstash (rate limiting) ──────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://xxxxxxxxxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# ─── Vercel Cron ──────────────────────────────────────────────────────────────
CRON_SECRET="change-me-random-secret-for-vercel-cron-auth-header"

# ─── Sentry ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="your-sentry-dsn"
SENTRY_AUTH_TOKEN="your-sentry-auth-token-for-sourcemap-upload"

# ─── Instagram Graph API ──────────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN="your-long-lived-instagram-access-token"
INSTAGRAM_BUSINESS_ACCOUNT_ID="your-instagram-business-account-id"

# ─── Shiprocket ───────────────────────────────────────────────────────────────
# There is no sandbox. These credentials are your live account, and any call
# made with them is real — see the note at the top of
# src/server/integrations/shiprocket.ts for which calls cost money and which
# are free to test against.
SHIPROCKET_EMAIL="your-shiprocket-account-email"
SHIPROCKET_PASSWORD="your-shiprocket-account-password"
# The pickup location's NICKNAME, exactly as it appears in Settings → Pickup
# Addresses. A mismatch fails every order creation with a message that does not
# mention the nickname.
SHIPROCKET_PICKUP_LOCATION="Primary"
# The pincode of that same pickup location. Serviceability is measured from it,
# so if it is wrong or missing every checkout lookup comes back unserviceable.
SHIPROCKET_PICKUP_PINCODE="560001"
# Shared secret for the tracking webhook, set alongside the URL in
# Settings → API → Webhooks. Shiprocket sends it back as `x-api-key`.
SHIPROCKET_WEBHOOK_TOKEN="a-long-random-string-you-choose"

# ─── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL="http://localhost:3000"

# ─── Social links (footer) ────────────────────────────────────────────────────
# Shown as icons in the site footer. Leave any blank to hide that icon.
# WhatsApp is a number with country code, no "+", spaces or dashes.
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/yourhandle"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/yourpage"
NEXT_PUBLIC_YOUTUBE_URL="https://youtube.com/@yourchannel"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# Set to 1 on a DEMO deployment so next/image will load the seeded
# placehold.co product images. Leave unset on the live site — it should never
# render images from a host we do not control. See next.config.ts.
ALLOW_PLACEHOLDER_IMAGES=""
